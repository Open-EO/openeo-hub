{
  "name": "@openeo/hub",
  "version": "1.0.0",
  "author": "openEO Consortium",
  "contributors": [
    {
      "name": "Christoph Friedrich"
    },
    {
      "name": "Matthias Mohr"
    }
  ],
  "description": "Platform for discovering openEO services and exchanging process graphs with the openEO community.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Open-EO/openeo-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-EO/openeo-hub.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "crawl": "node crawl.js",
    "crawl:verbose": "node crawl.js --verbose",
    "drop": "node drop.js",
    "up": "pm2 startOrRestart ecosystem.config.cjs",
    "down": "pm2 stop openeo-hub-server",
    "undeploy": "pm2 delete openeo-hub-server",
    "start:backend": "node server.js",
    "start:frontend": "vite",
    "build": "vite build",
    "start": "vite build && node server.js",
    "start:dev": "vite build --mode development && node server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@openeo/js-commons": "^1.5.0",
    "@openeo/js-processgraphs": "^1.4.2",
    "@openeo/vue-components": "^2.23.3",
    "@seald-io/nedb": "^4.1.2",
    "axios": "^1.8.0",
    "express": "^5.2.1",
    "moment": "^2.30.0",
    "vue": "^2.7.0",
    "vue-multiselect": "^2.1.9",
    "vue2-leaflet": "^1.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.4",
    "pm2": "^7.0.4",
    "sass": "^1.105.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "pm2": {
      "chokidar": "^4.0.3"
    },
    "basic-ftp": "^6.2.3",
    "js-yaml": "^4.3.2"
  }
}
